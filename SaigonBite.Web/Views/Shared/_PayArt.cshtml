@model PaymentMethod
@* Drawn placeholder shown until a real logo is found in wwwroot/images/payments. *@
@switch (Model)
{
    case PaymentMethod.Momo:
        <svg viewBox="0 0 40 40" aria-hidden="true" focusable="false"><rect width="40" height="40" rx="9" fill="#A50064"/><circle cx="20" cy="15" r="6" fill="none" stroke="#fff" stroke-width="2.5"/><path d="M9 31c1-6 5-8 11-8s10 2 11 8" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round"/></svg>
        break;
    case PaymentMethod.VnPay:
        <svg viewBox="0 0 40 40" aria-hidden="true" focusable="false"><rect width="40" height="40" rx="9" fill="#0B4DA2"/><path d="M8 13l8 16 4-9" fill="none" stroke="#fff" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M22 29V13h6a5 5 0 0 1 0 10h-6" fill="none" stroke="#E11D2A" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        break;
    case PaymentMethod.ApplePay:
        <svg viewBox="0 0 40 40" aria-hidden="true" focusable="false"><rect width="40" height="40" rx="9" fill="#111"/><path d="M20 14c2-3 5-3 5-3 0 3-2 5-4 5m-1 1c-3-1-8 1-8 7 0 5 4 9 6 9 1 0 2-1 3-1s2 1 3 1c2 0 5-4 5-6-3-1-4-6 0-8-2-3-6-3-9-1z" fill="#fff"/></svg>
        break;
    case PaymentMethod.PayPal:
        <svg viewBox="0 0 40 40" aria-hidden="true" focusable="false"><rect width="40" height="40" rx="9" fill="#F3F7FC"/><path d="M13 31l3-19h8c5 0 7 3 6 7-1 5-5 6-9 6h-3l-1 6z" fill="#003087"/><path d="M17 31l3-18h7c4 0 5 2 4 5-1 4-4 5-8 5h-3l-1 8z" fill="#009CDE" opacity=".85"/></svg>
        break;
    default:
        <svg viewBox="0 0 40 40" aria-hidden="true" focusable="false"><rect width="40" height="40" rx="9" fill="#1F8A4D"/><rect x="8" y="12" width="24" height="16" rx="3" fill="none" stroke="#fff" stroke-width="2.5"/><circle cx="20" cy="20" r="4" fill="#fff"/></svg>
        break;
}
