@model ErrorViewModel
@{
    ViewData["Title"] = L["ErrorTitle"];
}
<div class="sb-auth">
    <div class="sb-auth-art" aria-hidden="true"><partial name="_Scene" model='"lost"' /></div>
    <div class="card">
        <h1>@L["ErrorTitle"]</h1>
        <p class="text-muted">@L["ErrorText"]</p>
        @if (Model.ShowRequestId)
        {
            <p class="small mb-3">@L["ErrorRequestId"]: <code>@Model.RequestId</code></p>
        }
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary align-self-start">@L["DeniedBack"]</a>
    </div>
</div>
