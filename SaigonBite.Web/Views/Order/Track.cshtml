@model TrackViewModel
@{
    ViewData["Title"] = L["TrackTitle"];

    var flow = new[]
    {
        OrderStatus.Placed, OrderStatus.Confirmed, OrderStatus.Preparing,
        OrderStatus.Ready, OrderStatus.OutForDelivery, OrderStatus.Delivered
    };
    var terminal = Model.Detail.Status is OrderStatus.Cancelled or OrderStatus.Failed;
    var current = (int)Model.Detail.Status;
    var justPlaced = Model.Notice == "OrderPlaced";
    var courierPos = ((current + 0.5m) / flow.Length).ToString("0.####", System.Globalization.CultureInfo.InvariantCulture);
    var scene = Model.Detail.Status switch
    {
        OrderStatus.Placed or OrderStatus.Confirmed or OrderStatus.Preparing => "pan",
        OrderStatus.Ready or OrderStatus.OutForDelivery => "courier",
        OrderStatus.Delivered => "check",
        _ => "lost"
    };
}

@functions {
    private string StatusText(OrderStatus status) => L["Status" + status].Value;

    private string NoticeText()
    {
        return Model.Notice switch
        {
            "OrderPlaced" => L["OrderPlaced"].Value,
            "OrderCancelled" => L["OrderCancelled"].Value,
            "ItemsUpdated" => L["ItemsUpdated"].Value,
            "EditOnlyWhilePlaced" => L["EditOnlyWhilePlaced"].Value,
            _ => L["Notice"].Value
        };
    }
}

<div class="sb-page-head">
    <div>
        <h1>@L["TrackTitle"] — @L["OrderNumber"] #@Model.Detail.Id</h1>
        <p><partial name="_StatusBadge" model="Model.Detail.Status" /></p>
    </div>
    <a asp-action="MyOrders" class="btn btn-outline-secondary">@L["TrackBack"]</a>
</div>

@if (justPlaced)
{
    @* Short celebration right after placing: drawn tick + canvas confetti (site.js). *@
    <div class="sb-celebrate" data-celebrate aria-hidden="true">
        <partial name="_Scene" model='"check"' />
        <canvas class="sb-confetti" data-confetti></canvas>
    </div>
}
@if (!string.IsNullOrWhiteSpace(Model.Notice) && Model.Notice != "Notice")
{
    <div hidden data-toast-message="@NoticeText()" data-toast-type="@(Model.Notice == "EditOnlyWhilePlaced" ? "error" : "success")"></div>
}
@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-danger" role="alert">@Model.Error</div>
}

<div class="card mb-3">
    <div class="card-header">@L["StatusTimeline"]</div>
    <div class="card-body sb-track-body">
        <div class="sb-statushero">
            <div class="sb-status-art" aria-hidden="true"><partial name="_Scene" model="scene" /></div>
            <div class="sb-statushero-text">
                <small>@L["OrderNumber"] #@Model.Detail.Id</small>
                <strong>@StatusText(Model.Detail.Status)</strong>
                <span>@Model.Detail.PlacedAt.ToString("dd/MM/yyyy HH:mm")</span>
            </div>
        </div>
        <div class="sb-trackwrap @(terminal ? "" : "has-courier")" style="--p:@courierPos">
        @if (!terminal)
        {
            <div class="sb-courier-lane" aria-hidden="true"><span class="sb-courier"><span class="sb-courier-icon"><partial name="_Scene" model='"courier"' /></span></span></div>
        }
        <ol class="sb-steps @(terminal ? "is-stopped" : "")">
            @foreach (var step in flow)
            {
                var cls = terminal ? "" : current > (int)step ? "is-done" : current == (int)step ? "is-current" : "";
                <li class="@cls" aria-current="@(cls == "is-current" ? "step" : null)">@StatusText(step)</li>
            }
        </ol>
        </div>
        @if (terminal)
        {
            <div class="alert alert-danger mt-3 mb-0" role="alert">
                @L["Status"]: <strong>@StatusText(Model.Detail.Status)</strong>
            </div>
        }
    </div>
</div>

<div class="row g-3">
    <div class="col-12 col-lg-5">
        <div class="card mb-3">
            <div class="card-header">@L["CartSummary"]</div>
            <ul class="sb-lines">
                @foreach (var line in Model.Detail.Lines)
                {
                    <li>
                        <span class="sb-photo sb-photo-sm" data-img-base="/images/menu/@line.MenuItemId" data-img-name="@line.ItemName"><partial name="_FoodArt" model="line.Category" /></span>
                        <div class="sb-line-info">
                            <div class="fw-semibold">@line.ItemName</div>
                            <div class="small text-muted">@line.Quantity × @line.UnitPrice.ToString("N0")&nbsp;₫</div>
                        </div>
                        <div class="tabular fw-semibold">@((line.UnitPrice * line.Quantity).ToString("N0"))&nbsp;₫</div>
                    </li>
                }
            </ul>
            <div class="sb-lines-total"><span>@L["OrderTotal"]</span><strong class="tabular">@Model.Detail.Total.ToString("N0")&nbsp;₫</strong></div>
        </div>

        <div class="card mb-3">
            <div class="card-header">@L["OrderNumber"] #@Model.Detail.Id</div>
            <div class="card-body">
                <dl class="sb-kv">
                    <dt>@L["Status"]</dt>
                    <dd><partial name="_StatusBadge" model="Model.Detail.Status" /></dd>
                    <dt>@L["OrderTotal"]</dt>
                    <dd class="fw-bold tabular">@Model.Detail.Total.ToString("N0")&nbsp;₫</dd>
                    <dt>@L["PlacedAt"]</dt>
                    <dd>@Model.Detail.PlacedAt.ToString("dd/MM/yyyy HH:mm")</dd>
                    <dt>@L["DeliveryTo"]</dt>
                    <dd>@Model.Detail.DeliveryAddress</dd>
                    @if (!string.IsNullOrWhiteSpace(Model.Detail.HotelName))
                    {
                        <dt>@L["HotelName"]</dt>
                        <dd>@Model.Detail.HotelName / @Model.Detail.RoomNumber</dd>
                    }
                    <dt>@L["Distance"]</dt>
                    <dd data-count="@Model.Detail.DistanceKm.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)" data-decimals="1" data-suffix=" km">@Model.Detail.DistanceKm.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture) km</dd>
                    <dt>@L["Rain"]</dt>
                    <dd>@(Model.Detail.HeavyRain ? L["Yes"] : L["No"])</dd>
                    @if (!string.IsNullOrWhiteSpace(Model.Detail.VoucherNote))
                    {
                        <dt>@L["VoucherNote"]</dt>
                        <dd>@Model.Detail.VoucherNote</dd>
                    }
                </dl>
            </div>
        </div>

        @if (Model.Actions.CanEdit || Model.Actions.CanCancel)
        {
            <div class="card">
                <div class="card-body d-flex flex-column gap-3">
                    @if (Model.Actions.CanEdit)
                    {
                        <a asp-action="Edit" asp-route-id="@Model.Detail.Id" class="btn btn-outline-primary">@L["EditItems"]</a>
                    }
                    @if (Model.Actions.CanCancel)
                    {
                        <form asp-action="Cancel" method="post" class="row g-2" data-confirm="@L["ConfirmCancelOrder"]">
                            <input type="hidden" name="id" value="@Model.Detail.Id" />
                            <div class="col-12">
                                <label class="form-label" for="cancel-reason">@L["CancelReason"]</label>
                                <input class="form-control" id="cancel-reason" name="reason" />
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-outline-danger">@L["CancelOrder"]</button>
                            </div>
                        </form>
                    }
                </div>
            </div>
        }
    </div>

    <div class="col-12 col-lg-7">
        <div class="card">
            <div class="card-header">@L["StatusHistory"]</div>
            @if (Model.History.Count == 0)
            {
                <div class="sb-empty">@L["HistoryEmpty"]</div>
            }
            else
            {
                <ol class="sb-timeline">
                    @foreach (var row in Model.History)
                    {
                        <li>
                            <div class="fw-semibold">
                                @(row.FromStatus is { } fromStatus ? StatusText(fromStatus) + " → " : string.Empty)@StatusText(row.ToStatus)
                            </div>
                            <div class="sb-when">@row.ChangedAt.ToString("dd/MM/yyyy HH:mm") · @row.ActorIdentifier</div>
                            @if (!string.IsNullOrWhiteSpace(row.Reason))
                            {
                                <div class="sb-why">@L["Reason"]: @row.Reason</div>
                            }
                        </li>
                    }
                </ol>
            }
        </div>
    </div>
</div>
