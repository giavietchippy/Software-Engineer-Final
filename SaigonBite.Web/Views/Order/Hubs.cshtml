@model HubsViewModel
@{
    ViewData["Title"] = L["HubsTitle"];
}

<div class="row">
    <div class="col-12">
        <h1 class="h3 mb-2">@L["HubsTitle"]</h1>
        <p class="text-muted">@L["HubsSubtitle"]</p>
    </div>
</div>

@if (!Model.Hubs.Any())
{
    <div class="alert alert-warning" role="alert">@L["HubNoHubs"]</div>
}

<div class="row g-3">
    @foreach (var hub in Model.Hubs)
    {
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card h-100 @(hub.IsBusy ? "border-secondary bg-light text-muted" : "")">
                <div class="card-body d-flex flex-column">
                    <h2 class="h5 card-title">@hub.Name</h2>
                    <p class="mb-1"><strong>@L["HubLoad"]:</strong> @hub.Load.ToString("P0") (@hub.Busy/@hub.Capacity)</p>
                    <p class="mb-2"><strong>@L["HubCapacity"]:</strong> @hub.Capacity</p>
                    @if (hub.IsQuiet && !hub.IsBusy)
                    {
                        <span class="badge bg-success align-self-start mb-2">@L["HubQuiet"]</span>
                    }
                    @if (hub.IsBusy)
                    {
                        <span class="badge bg-secondary align-self-start mb-2">@L["HubBusy"]</span>
                        <div class="alert alert-secondary small" role="alert">@L["HubBusyMessage"]</div>
                    }
                    else
                    {
                        <a asp-controller="Order" asp-action="Menu" asp-route-hubId="@hub.Id" class="btn btn-primary mt-auto">@L["HubOpen"]</a>
                    }
                </div>
            </div>
        </div>
    }
</div>
