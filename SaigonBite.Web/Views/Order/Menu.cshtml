@model MenuViewModel
@{
    ViewData["Title"] = L["MenuTitle"];
    var itemCount = Model.Brands.Sum(b => b.Items.Count);
}

<div class="row g-3">
    <div class="col-12">
        <h1 class="h3 mb-1">@L["MenuTitle"] — @Model.HubName</h1>
        <p class="text-muted mb-2">@L["MenuFor"] <strong>@Model.HubName</strong></p>
    </div>

    @if (itemCount == 0)
    {
        <div class="col-12">
            <div class="alert alert-warning" role="alert">@L["MenuEmpty"]</div>
            <a asp-controller="Order" asp-action="Hubs" class="btn btn-outline-secondary">@L["MenuBack"]</a>
        </div>
    }
    else
    {
        <div class="col-12">
            <div class="alert alert-info small" role="alert">@L["CartMax"]</div>
            <form asp-action="Cart" method="post">
                <input type="hidden" name="hubId" value="@Model.HubId" />
                @foreach (var brand in Model.Brands.Where(b => b.Items.Count > 0))
                {
                    <div class="card mb-3">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h2 class="h6 mb-0">@L["Brand"]: @brand.Name</h2>
                            <span class="badge bg-light text-dark">@brand.Items.Count</span>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th scope="col">@L["Item"]</th>
                                        <th scope="col">@L["Category"]</th>
                                        <th scope="col" class="text-end">@L["Price"]</th>
                                        <th scope="col" class="text-center">@L["Quantity"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in brand.Items)
                                    {
                                        <tr>
                                            <td>@item.Name</td>
                                            <td>@L["Category" + item.Category]</td>
                                            <td class="text-end">@item.Price.ToString("N0")</td>
                                            <td class="text-center">
                                                <input type="hidden" name="itemIds" value="@item.Id" />
                                                <input class="form-control form-control-sm mx-auto" style="max-width:6rem"
                                                       type="number" min="0" max="20" step="1" name="quantities" value="0"
                                                       aria-label="@L["Quantity"] - @item.Name" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">@L["MenuAddToCart"] / @L["MenuContinue"]</button>
                    <a asp-controller="Order" asp-action="Hubs" class="btn btn-outline-secondary">@L["MenuBack"]</a>
                </div>
            </form>
        </div>
    }
</div>
