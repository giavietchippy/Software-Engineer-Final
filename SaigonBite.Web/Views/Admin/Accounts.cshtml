@model IReadOnlyList<AccountDto>
@{
    ViewData["Title"] = L["AccountsTitle"];
    var search = Context.Request.Query["search"].ToString();
}

<div class="sb-page-head">
    <div>
        <h1>@L["AccountsTitle"]</h1>
        <p>@Model.Count @L["AccountsCount"]</p>
    </div>
</div>

@if (TempData["Notice"] != null)
{
    <div class="alert alert-info" role="status">@TempData["Notice"]</div>
}

<form asp-action="Accounts" method="get" class="row g-2 mb-3">
    <div class="col-12 col-md-5 col-lg-4">
        <label class="visually-hidden" for="search">@L["Search"]</label>
        <input class="form-control" id="search" name="search" type="search" value="@search" placeholder="@L["AccountsSearch"]" />
    </div>
    <div class="col-auto"><button class="btn btn-outline-secondary" type="submit">@L["Search"]</button></div>
    @if (!string.IsNullOrEmpty(search))
    {
        <div class="col-auto"><a class="btn btn-link" asp-action="Accounts">@L["ClearSearch"]</a></div>
    }
</form>

<div class="sb-table-wrap mb-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle" data-paginate="10" data-prev-label="@L["Previous"]" data-next-label="@L["Next"]">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>@L["AccountRole"]</th>
                    <th>@L["Identifier"]</th>
                    <th>@L["AccountHub"]</th>
                    <th>@L["AccountStatus"]</th>
                    <th class="text-end"><span class="visually-hidden">@L["AccountAction"]</span></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr data-empty><td colspan="6"><div class="sb-empty">@L["AccountsEmpty"]</div></td></tr>
                }
                @foreach (var account in Model)
                {
                    var active = !account.IsDeleted && account.IsActive;
                    <tr>
                        <td class="tabular">@account.Id</td>
                        <td><span class="sb-pill">@account.Role</span></td>
                        <td class="fw-semibold sb-wrap">@account.Identifier</td>
                        <td>@(account.HubId?.ToString() ?? "–")</td>
                        <td>
                            @if (active)
                            {
                                <span class="sb-pill sb-pill-ok">@L["AccountActive"]</span>
                            }
                            else
                            {
                                <span class="sb-pill sb-pill-bad">@L["AccountInactive"]</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (active)
                            {
                                <form asp-action="Deactivate" method="post" class="d-inline" data-confirm="@L["ConfirmDeactivate"]">
                                    <input type="hidden" name="id" value="@account.Id" />
                                    <button class="btn btn-sm btn-outline-danger" type="submit">@L["Deactivate"]</button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="Reactivate" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@account.Id" />
                                    <button class="btn btn-sm btn-outline-success" type="submit">@L["Reactivate"]</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="card">
    <div class="card-header">@L["CreateStaff"]</div>
    <div class="card-body">
        <form asp-action="CreateStaff" method="post" class="row g-3">
            <div class="col-12 col-md-3">
                <label class="form-label" for="Role">@L["AccountRole"]</label>
                <select class="form-select" id="Role" name="Role">
                    <option value="@Role.KitchenStaff">KitchenStaff</option>
                    <option value="@Role.Shipper">Shipper</option>
                    <option value="@Role.Admin">Admin</option>
                </select>
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label" for="Identifier">@L["Identifier"]</label>
                <input class="form-control" id="Identifier" name="Identifier" autocomplete="off" />
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label" for="Password">@L["PasswordMin"]</label>
                <input class="form-control" id="Password" name="Password" type="password" autocomplete="new-password" />
            </div>
            <div class="col-12 col-md-3" data-show-when="#Role=KitchenStaff">
                <label class="form-label" for="HubId">@L["HubIdKitchen"]</label>
                <input class="form-control" id="HubId" name="HubId" type="number" min="1" />
            </div>
            <div class="col-12"><button class="btn btn-primary" type="submit">@L["CreateButton"]</button></div>
        </form>
    </div>
</div>
