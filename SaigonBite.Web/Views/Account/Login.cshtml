@{
    ViewData["Title"] = L["LoginTitle"];
}
<div class="sb-auth">
    <div class="sb-auth-art" aria-hidden="true"><partial name="_Scene" model='"courier"' /></div>
    <div class="card">
        <h1>@L["LoginTitle"]</h1>
        <p class="text-muted">@L["LoginSubtitle"]</p>

        @if (ViewData["Error"] != null)
        {
            <div class="alert alert-danger" role="alert">@ViewData["Error"]</div>
        }
        @if (TempData["Notice"] != null)
        {
            <div hidden data-toast-message="@TempData["Notice"]" data-toast-type="success"></div>
        }

        <form asp-action="Login" method="post">
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
            <div class="mb-3">
                <label class="form-label" for="identifier">@L["Identifier"]</label>
                <input class="form-control" id="identifier" name="identifier" autocomplete="username" autofocus />
            </div>
            <div class="mb-3">
                <label class="form-label" for="password">@L["Password"]</label>
                <input class="form-control" id="password" name="password" type="password" autocomplete="current-password" />
            </div>
            <button type="submit" class="btn btn-primary w-100">@L["LoginButton"]</button>
        </form>
    </div>
    <p class="mt-3 text-center"><a asp-action="Register">@L["LoginRegisterLink"]</a></p>
</div>
