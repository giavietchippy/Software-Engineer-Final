@{
    ViewData["Title"] = "Login";
}
<h1>Login</h1>

@if (ViewData["Error"] != null)
{
    <div class="alert alert-danger">@ViewData["Error"]</div>
}
@if (TempData["Notice"] != null)
{
    <div class="alert alert-success">@TempData["Notice"]</div>
}

<form asp-action="Login" method="post" class="col-md-5">
    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
    <div class="mb-3">
        <label class="form-label" for="identifier">Identifier</label>
        <input class="form-control" id="identifier" name="identifier" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="password">Password</label>
        <input class="form-control" id="password" name="password" type="password" />
    </div>
    <button type="submit" class="btn btn-primary">Log in</button>
</form>

<p class="mt-3"><a asp-action="Register">Register a customer account</a></p>
