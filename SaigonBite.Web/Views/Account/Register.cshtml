@model RegistrationInput
@{
    ViewData["Title"] = L["NavRegister"];
}
<div class="sb-auth wide">
    <div class="sb-auth-art" aria-hidden="true"><partial name="_Scene" model='"bowl"' /></div>
    <div class="card">
        <h1>@L["RegisterTitle"]</h1>
        <p class="text-muted">@L["RegisterSubtitle"]</p>

        @if (ViewData["Error"] != null)
        {
            <div class="alert alert-danger" role="alert">@ViewData["Error"]</div>
        }

        <form asp-action="Register" method="post">
            <div class="mb-3">
                <label class="form-label" for="Role">@L["CustomerType"]</label>
                <select class="form-select" asp-for="Role">
                    <option value="@Role.Local">@L["TypeLocal"]</option>
                    <option value="@Role.Tourist">@L["TypeTourist"]</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="Identifier">@L["MobileOrPassport"]</label>
                <input class="form-control" asp-for="Identifier" autocomplete="username" />
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="Password">@L["PasswordMin"]</label>
                <input class="form-control" asp-for="Password" type="password" autocomplete="new-password" />
            </div>
            <div data-show-when="#Role=Tourist">
                <div class="mb-3">
                    <label class="form-label" asp-for="Nationality">@L["Nationality"]</label>
                    <input class="form-control" asp-for="Nationality" />
                </div>
                <div class="mb-3">
                    <label class="form-label" asp-for="Email">@L["Email"]</label>
                    <input class="form-control" asp-for="Email" type="email" autocomplete="email" />
                </div>
            </div>
            <button type="submit" class="btn btn-primary w-100">@L["RegisterButton"]</button>
        </form>
    </div>
    <p class="mt-3 text-center"><a asp-action="Login">@L["RegisterLoginLink"]</a></p>
</div>
