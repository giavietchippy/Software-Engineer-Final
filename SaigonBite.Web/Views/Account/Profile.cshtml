@model SelfProfileDto?
@{
    ViewData["Title"] = L["ProfileTitle"];
}
<div class="sb-auth wide">
    <div class="card">
        <h1>@L["ProfileTitle"]</h1>

        @if (ViewData["Notice"] != null)
        {
            <div hidden data-toast-message="@ViewData["Notice"]" data-toast-type="@(ViewData["Notice"]?.ToString() == "Profile saved." ? "success" : "error")"></div>
        }
        @if (Model is null)
        {
            <div class="alert alert-warning" role="alert">@L["ProfileNotFound"]</div>
        }
        else
        {
            <p class="mb-3">@L["ProfileRole"]: <span class="sb-pill sb-pill-accent">@Model.Role</span></p>
            <form asp-action="Profile" method="post">
                <div class="mb-3">
                    <label class="form-label" for="Identifier">@L["MobileOrPassport"]</label>
                    <input class="form-control" id="Identifier" name="Identifier" value="@Model.Identifier" />
                </div>
                @if (Model.Role == Role.Tourist)
                {
                    <div class="mb-3">
                        <label class="form-label" for="Nationality">@L["Nationality"]</label>
                        <input class="form-control" id="Nationality" name="Nationality" value="@Model.Nationality" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="Email">@L["Email"]</label>
                        <input class="form-control" id="Email" name="Email" value="@Model.Email" />
                    </div>
                }
                <div class="mb-3">
                    <label class="form-label" for="Password">@L["NewPasswordOptional"]</label>
                    <input class="form-control" id="Password" name="Password" type="password" autocomplete="new-password" />
                </div>
                <button type="submit" class="btn btn-primary">@L["SaveChanges"]</button>
            </form>
        }
    </div>
</div>
